# HarnessPRD 环境变量模板
# 用法: 复制本文件为 .env 并填入真实值；.env 已在 .gitignore 中，切勿提交

# LLM Provider 密钥（至少填入一个，留空的 Provider 不可用）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 默认使用的 Provider: anthropic | openai
# 使用火山方舟等 OpenAI 兼容网关时，设为 openai 并填写 OPENAI_BASE_URL
DEFAULT_LLM_PROVIDER=anthropic

# 默认模型（切换 provider / 网关时必须改成对应平台支持的模型 ID）
# - Anthropic 官方: 如 claude-sonnet-4-20250514
# - 火山方舟 Ark: 在控制台「模型广场」开通模型后，复制其模型 ID（或推理接入点 ep-xxx）
DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

# OpenAI 兼容网关地址（可选项；直连官方时留空）
# 火山方舟（北京区域）: https://ark.cn-beijing.volces.com/api/v3
OPENAI_BASE_URL=

# Anthropic 兼容网关地址（可选项；直连官方时留空）
ANTHROPIC_BASE_URL=

# 输出长度上限：对话回复 / 长文档生成（过小程序文档会被截断）
LLM_MAX_TOKENS=4096
DOC_MAX_TOKENS=16384

# 网关推理模型是否开启深度思考（false=关闭，更快更省；仅 OpenAI 兼容网关生效）
LLM_THINKING_ENABLED=false

# 允许跨域访问的前端地址，多个地址用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# 服务监听地址与端口
HOST=0.0.0.0
PORT=8000
